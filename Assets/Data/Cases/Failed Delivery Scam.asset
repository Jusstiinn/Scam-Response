%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f0d9b320ba1bccb4f9fd7e7f2cb4c281, type: 3}
  m_Name: Failed Delivery Scam
  m_EditorClassIdentifier: Assembly-CSharp::ScamCaseData
  caseId: C02
  queueNumber: A102
  caseTitle: Failed Delivery Scam
  scamType: Delivery Phishing Scam
  victimName: Emily Wong
  victimAge: 34
  victimOccupation: Office Administrator
  initialComplaint: I received a text message saying that my parcel delivery had
    failed and that I needed to update my information before they could deliver it
    again.
  lobbyNpcPrefab: {fileID: 4118902309913946028, guid: e32b65b80c78c474488e45af03a50738, type: 3}
  interviewNpcPrefab: {fileID: 4118902309913946028, guid: e32b65b80c78c474488e45af03a50738, type: 3}
  behaviourType: 1
  interviewDecisions:
  - npcLine: I was expecting a parcel that week, so when I received the delivery
      message I didn't think it was suspicious.
    choices:
    - playerChoice: What exactly did the message ask you to do?
      npcResponse: It said the delivery had failed and gave me a link to update my
        delivery details before they could attempt another delivery.
      unlockedFactIds:
      - failed_delivery_sms
      - delivery_update_link
    - playerChoice: You shouldn't click delivery links from random messages.
      npcResponse: I know that now. At the time I was expecting something, so it
        seemed normal.
      unlockedFactIds:
      - failed_delivery_sms
  - npcLine: The website asked me to enter my card information to pay a small redelivery
      charge.
    choices:
    - playerChoice: What card information did you enter?
      npcResponse: My card number, expiry date and security code. The charge was
        only a small amount, so I didn't think much about it.
      unlockedFactIds:
      - card_details
      - card_number
      - expiry_date
      - security_code
      - small_fee
    - playerChoice: Why would a courier need all your card details?
      npcResponse: I thought it was just for the redelivery payment. I don't remember
        everything I entered.
      unlockedFactIds:
      - card_details
      - small_fee
  - npcLine: Later I noticed transactions on my card that I didn't recognise.
    choices:
    - playerChoice: Did anything happen after you entered the card information?
      npcResponse: Yes. I started seeing transactions I didn't make. That's when
        I realised the delivery website may have stolen my card information.
      unlockedFactIds:
      - unauthorised_transactions
      - stolen_card_details
    - playerChoice: You really should have checked the website first.
      npcResponse: I understand. I just want to know what I should do now.
      unlockedFactIds:
      - unauthorised_transactions
  caseFileQuestions:
  - questionId: delivery_contact
    prompt: How was the victim first contacted?
    options:
    - Failed delivery SMS
    - Bank letter
    - Security alert email
    - Phone call
    correctOptionIndex: 0
    supportingFactId: failed_delivery_sms
    explanation: The victim received a fake delivery SMS claiming that their parcel
      delivery had failed.
  - questionId: delivery_request
    prompt: What did the fake website request?
    options:
    - Card information
    - Passport details
    - School login
    - Social media password
    correctOptionIndex: 0
    supportingFactId: card_details
    explanation: The fake delivery website asked the victim to enter their card information
      to pay a supposed redelivery fee.
  - questionId: delivery_hook
    prompt: What encouraged the victim to enter their payment information?
    options:
    - Small redelivery fee
    - Investment bonus
    - Account suspension warning
    - Job application fee
    correctOptionIndex: 0
    supportingFactId: small_fee
    explanation: The scam used a small redelivery fee to make the payment request
      appear reasonable and convince the victim to enter their card details.
  - questionId: delivery_result
    prompt: What happened after the victim entered the card information?
    options:
    - Unauthorised transactions appeared
    - Their email account was deleted
    - Their parcel arrived immediately
    - Their phone stopped working
    correctOptionIndex: 0
    supportingFactId: unauthorised_transactions
    explanation: After entering their card information, the victim discovered unauthorised
      transactions, indicating that their card details had been compromised.
  howTheScamWorks: Scammers send fake delivery notifications claiming that a parcel
    could not be delivered. The message contains a phishing link that directs the
    victim to a fake courier website. Victims may then be asked to enter card information
    to pay a small redelivery charge.
  warningSigns: "\u2022 Unexpected delivery messages.\n\u2022 Suspicious links.\n\u2022
    Requests for card information for very small charges.\n\u2022 Website addresses
    that do not match the official courier.\n\u2022 Messages creating urgency about
    a parcel being returned or cancelled."
  howToAvoid: Check deliveries using the courier company's official application or
    website instead of links received through SMS. Do not enter card information
    on websites reached through suspicious messages.
  whatToDoIfVictim: Contact the bank immediately if card information has been entered
    into a suspicious website. Review recent transactions, block or replace the affected
    card where necessary and report unauthorised transactions.
